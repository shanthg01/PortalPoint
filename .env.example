# Shared AWS RDS PostgreSQL 15 (see docs/aws_rds_setup.md)
# RDS has no public/per-IP access — reach it through the bastion SSH tunnel:
#   ssh -i portalpoint-bastion.pem -L 5433:portalpoint-db.con8amymqi1e.us-east-1.rds.amazonaws.com:5432 ec2-user@<bastion-public-ip> -N -o ServerAliveInterval=60 -o ServerAliveCountMax=3
# Get the .pem key + bastion IP + portalpoint_app password from Justin (DM — never commit real values here)
DATABASE_URL=postgresql+asyncpg://portalpoint_app:<password>@127.0.0.1:5433/portalpoint?ssl=require

# Local Docker fallback (offline dev only — same port as the bastion tunnel above,
# don't run both at once)
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/portalpoint

REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600        # set to 86400 in local dev to avoid hourly re-login
ENVIRONMENT=development

# AWS S3 — shared team bucket (see docs/aws_s3_setup.md)
# Get AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY from Justin (DM — never commit).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=portalpoint-data
# AWS_S3_ENDPOINT_URL=   # only needed for a self-hosted MinIO deploy; leave unset for the real AWS-hosted path

# Hoop Explorer — CSV export URLs (obtain by inspecting network request on hoop-explorer.com
# when clicking "Export CSV"; URLs are session-authenticated, re-capture after login)
# HE_PLAYER_EXPORT_URL=
# HE_TEAM_EXPORT_URL=
# HE_SESSION_COOKIE=       # optional — copy from browser devtools if auth required

# MLflow — tracking metadata (NOT s3:// — see docs/aws_s3_setup.md)
# Install: uv pip install -r notebooks/requirements-notebooks.txt
MLFLOW_TRACKING_URI=sqlite:///mlruns.db
# MLflow UI: uv run mlflow ui --backend-store-uri sqlite:///mlruns.db
# Artifacts (when wired): s3://portalpoint-data/mlflow/
# MLFLOW_S3_ENDPOINT_URL=   # only needed for a self-hosted MinIO deploy; leave unset for the real AWS-hosted path

# News-monitoring agent (scripts/run_news_monitoring.py)
# Get keys from team lead — never commit real values here.
# TAVILY_API_KEY=
# GOOGLE_API_KEY=
