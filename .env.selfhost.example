# .env.selfhost.example
#
# Env file for docker-compose.selfhost.yml — the self-hosted, single-VM
# stack (Postgres+pgvector, Redis, MinIO in place of S3, Caddy in place of
# CloudFront/ALB) described in CLAUDE.md's AWS section. Not the same as the
# repo-root .env.example, which targets the shared AWS RDS dev setup.
#
# Copy this file to .env.selfhost and fill in every CHANGE_ME value:
#   cp .env.selfhost.example .env.selfhost
#
# Then run:
#   docker compose -f docker-compose.selfhost.yml --env-file .env.selfhost up -d
#
# ⚠️ FOOTGUNS — these values are duplicated on purpose (docker-compose has
# no way to interpolate one env var into another across services) and MUST
# match exactly, or the corresponding service will fail to authenticate:
#   - POSTGRES_PASSWORD must match the password embedded in DATABASE_URL
#   - MINIO_ROOT_USER/MINIO_ROOT_PASSWORD must match
#     AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# Both pairs are called out again inline below at the point they occur.

# --- Database (postgres service — pgvector/pgvector:pg15) -----------------
# NOTE: POSTGRES_PASSWORD below MUST be the same string as the password in
# DATABASE_URL's connection string. If you change one, change the other.
POSTGRES_DB=portalpoint
POSTGRES_USER=portalpoint_app
POSTGRES_PASSWORD=CHANGE_ME

# asyncpg driver, internal docker network hostname (`postgres`, not
# localhost/127.0.0.1), no TLS needed between containers on the same
# compose network -> sslmode=disable.
DATABASE_URL=postgresql+asyncpg://portalpoint_app:CHANGE_ME@postgres:5432/portalpoint?sslmode=disable

# --- Redis (redis service) --------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Auth --------------------------------------------------------------
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600

# --- App environment -----------------------------------------------------
ENVIRONMENT=production

# Space-separated origins (see core/config.py's cors_origins_list). Must be
# your real domain (matching the Caddyfile), served over https://.
CORS_ORIGINS=https://yourdomain.example

# --- Object storage (minio service, standing in for AWS S3) ---------------
S3_BUCKET=portalpoint-data

# MinIO speaks the S3 API and accepts any access/secret key pair as its
# root credentials — these are NOT real AWS keys, they're whatever you set
# MinIO's root user/password to.
#
# ⚠️ FOOTGUN: AWS_ACCESS_KEY_ID must equal MINIO_ROOT_USER, and
# AWS_SECRET_ACCESS_KEY must equal MINIO_ROOT_PASSWORD, exactly. boto3 (used
# directly by notebooks/utils/s3_helpers.py, and internally by MLflow's S3
# artifact repo) authenticates with the AWS_* pair below; MinIO itself
# authenticates incoming requests against MINIO_ROOT_USER/PASSWORD further
# down. If these two pairs don't match, every S3 call fails auth.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# Arbitrary — MinIO ignores region entirely, but boto3/MLflow both require
# a non-empty value to be set, so this can't be blank.
AWS_DEFAULT_REGION=us-east-1

# Point the S3 client at MinIO instead of real AWS S3. MLflow's S3 artifact
# repo natively honors MLFLOW_S3_ENDPOINT_URL — no code change needed for
# that half. AWS_S3_ENDPOINT_URL is consumed by a code change to
# notebooks/utils/s3_helpers.py landing in a parallel workstream (not
# implemented in this file's stack) — set it here now so it's already wired
# once that lands.
AWS_S3_ENDPOINT_URL=http://minio:9000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# --- MinIO root credentials (minio + minio-init services) -----------------
# ⚠️ FOOTGUN: these MUST equal AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY above
# — same credential, two names, because MinIO's own config vars and the
# generic AWS_* vars boto3/MLflow expect are necessarily different env var
# names for the same secret.
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_16_CHARS_MIN

# --- MLflow tracking ------------------------------------------------------
# Local sqlite backend store, on the `mlflow_data` named volume (mounted at
# /app/data on the backend service in docker-compose.selfhost.yml) so run
# metadata survives container restarts/recreates. Artifacts still go to
# MinIO via MLFLOW_S3_ENDPOINT_URL above + S3_BUCKET.
MLFLOW_TRACKING_URI=sqlite:////app/data/mlruns.db
