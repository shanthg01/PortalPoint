CLAUDE.md
.env

# Data files (large, downloaded locally)
data/
.torvik_cache/

# Jupyter
.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.pyo
.venv/
*.egg-info/
dist/
build/

# Environment
.env
.env.local
.env.*.local

# uv
.python-version
# uv.lock is committed intentionally — Dockerfile needs it for `uv sync --frozen`,
# and CI/fresh clones have no local copy otherwise (real build break found via PR #65 review)

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# Type checking
.mypy_cache/

# Ruff
.ruff_cache/

# MLflow (added when ML pipeline is wired)
mlruns/
mlartifacts/
**/mlruns.db
**/mlruns_backup.db

# Frontend
frontend/node_modules/
frontend/dist/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Large data files (S3 is source of truth; do not commit raw PBP / feature parquets)
data/hoopr/
notebooks/data/
data/features/
data/models/*.pkl
data/model_validation/

# DB dumps (contain full DB contents — never commit)
*.dump
*.sql.gz

# SSH keys (never commit private keys)
*.pem

# One-time IAM setup artifacts, not app config
gha-trust-policy.json
ssm-bastion-policy.json
ecs-trust-policy.json
secrets-read-policy.json
s3-access-policy.json
task-def.json
cloudfront-config.json
s3-bucket-policy.json
logs-policy.json
ssm-tunnel-params.json
ssm-cache-tunnel-params.json
gha-frontend-deploy-policy.json
efs-mlflow-policy.json

# Terraform (infra/aws) -- state can contain secret values; never commit it
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
infra/aws/*.log
